/**
 * Interaction QA for I Choose How â€” session-only, no network assertions beyond file://.
 * Run: node scripts/qa-interaction.mjs
 */
const { chromium, firefox } = require("playwright");
const path = require("path");
const fs = require("fs");

const root = path.resolve(__dirname, "..");
const indexUrl = "file:///" + path.join(root, "index.html").replace(/\\/g, "/");
const shotDir = path.join(root, "docs", "screenshots");
fs.mkdirSync(shotDir, { recursive: true });

const results = [];
function log(ok, msg) {
  results.push({ ok, msg });
  console.log((ok ? "PASS" : "FAIL") + " â€” " + msg);
}

async function clickText(page, text, exact = false) {
  const btn = page.getByRole("button", { name: text, exact }).first();
  await btn.click();
}

async function runFlow(browserType, name, takeShots) {
  const browser = await browserType.launch({
    headless: true,
    executablePath:
      name === "edge"
        ? "C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe"
        : undefined,
    channel: name === "edge" ? "msedge" : undefined
  }).catch(async () => {
    if (name === "edge") {
      return chromium.launch({
        headless: true,
        executablePath:
          "C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe"
      });
    }
    return browserType.launch({ headless: true });
  });

  const context = await browser.newContext({
    viewport: { width: 375, height: 812 }
  });
  const page = await context.newPage();
  page.on("console", (msg) => {
    if (msg.type() === "error") log(false, name + " console error: " + msg.text());
  });
  page.on("pageerror", (err) => log(false, name + " pageerror: " + err.message));

  await page.goto(indexUrl);
  await page.waitForSelector("#main");

  // Welcome branding
  const tagline = await page.locator(".lead").innerText();
  log(tagline.includes("My voice") && tagline.includes("My choices") && tagline.includes("My way"),
    name + ": welcome tagline");
  const wm = page.locator(".welcome-wordmark");
  log(await wm.count() === 1, name + ": welcome wordmark present");
  if (takeShots) await page.screenshot({ path: path.join(shotDir, "welcome.png") });

  // No localStorage / cookie writes expected â€” check after interactions
  await clickText(page, "Start");
  await clickText(page, "Consent");
  await clickText(page, "Read");
  await clickText(page, "Help Sam understand");
  await clickText(page, "Continue");
  await clickText(page, "I understand");

  // Question builder â€” consent
  log(await page.getByRole("heading", { name: "What would Sam like to ask?" }).count() === 1,
    name + ": consent QB title");
  log((await page.locator("#main").innerText()).includes("Choose one or more questions"),
    name + ": consent QB instruction");
  if (takeShots) await page.screenshot({ path: path.join(shotDir, "consent-question-builder.png") });

  const q1 = page.getByRole("button", { name: /What information will be shared/ });
  await q1.click();
  log((await q1.getAttribute("aria-pressed")) === "true", name + ": select real question");

  const none = page.getByRole("button", { name: /I do not have a question yet/ });
  await none.click();
  log((await none.getAttribute("aria-pressed")) === "true", name + ": none-yet exclusive on");
  log((await q1.getAttribute("aria-pressed")) === "false", name + ": none-yet clears others");

  await q1.click();
  log((await none.getAttribute("aria-pressed")) === "false", name + ": real question clears none-yet");
  log((await q1.getAttribute("aria-pressed")) === "true", name + ": real question selected again");

  // Empty selection allowed â€” deselect all
  await q1.click();
  log((await q1.getAttribute("aria-pressed")) === "false", name + ": empty selection allowed");

  // Multi-select
  await page.getByRole("button", { name: /Who will see it/ }).click();
  await page.getByRole("button", { name: /Can I change my mind later/ }).click();

  // Back preserves
  await page.click("#btn-back");
  await clickText(page, "I understand");
  log((await page.getByRole("button", { name: /Who will see it/ }).getAttribute("aria-pressed")) === "true",
    name + ": Back preserves selections");

  await clickText(page, "See summary");
  const summaryText = await page.locator("#main").innerText();
  log(summaryText.includes("Who will see it?"), name + ": summary lists questions");
  log(summaryText.includes("Can I change my mind later?"), name + ": summary lists second question");
  log(summaryText.includes("Read") || summaryText.includes("How information was shown"),
    name + ": summary shows mode");
  if (takeShots) await page.screenshot({ path: path.join(shotDir, "summary-consent.png") });

  // Home clears
  await page.click("#btn-home");
  await clickText(page, "Start");
  await clickText(page, "Service agreement");
  await clickText(page, "Show me");
  await clickText(page, "Help Sam understand");
  // Walk agreement cards
  for (let i = 0; i < 3; i++) {
    await clickText(page, "Next part");
  }
  await clickText(page, "Continue");
  await clickText(page, "I understand");

  log(await page.getByRole("heading", { name: "What would Sam like to ask?" }).count() === 1,
    name + ": agreement QB title");
  if (takeShots) await page.screenshot({ path: path.join(shotDir, "agreement-question-builder.png") });

  await page.getByRole("button", { name: /What support will I get/ }).click();
  await page.getByRole("button", { name: /I do not have a question yet/ }).click();
  log((await page.getByRole("button", { name: /What support will I get/ }).getAttribute("aria-pressed")) === "false",
    name + ": agreement none-yet exclusive");

  await clickText(page, "See summary");
  log((await page.locator("#main").innerText()).includes("I do not have a question yet."),
    name + ": summary shows none-yet neutrally");

  // Storage check
  const storage = await page.evaluate(() => ({
    ls: Object.keys(localStorage).length,
    ss: Object.keys(sessionStorage).length,
    cookies: document.cookie
  }));
  log(storage.ls === 0 && storage.ss === 0 && storage.cookies === "",
    name + ": no localStorage/sessionStorage/cookies");

  // Mode switching on pathway
  await page.click("#btn-restart");
  await clickText(page, "Start");
  await clickText(page, "Consent");
  await clickText(page, "Listen");
  log(await page.locator(".listen-controls").count() === 1 ||
    (await page.locator("#main").innerText()).length > 0,
    name + ": listen mode reachable");
  // Ensure no autoplay utterance immediately â€” speechSynthesis speaking should be false
  const speaking = await page.evaluate(() => {
    try { return window.speechSynthesis && window.speechSynthesis.speaking; } catch (e) { return false; }
  });
  log(!speaking, name + ": listen does not autoplay");

  // Keyboard About dialog
  await page.click("#btn-about");
  log(await page.locator("#about-dialog").isVisible(), name + ": About opens");
  await page.keyboard.press("Escape");
  log(!(await page.locator("#about-dialog").isVisible()), name + ": Escape closes About");

  // Eight combinations smoke (fast navigations)
  const modes = ["Read", "Listen", "Show me", "With a supporter"];
  for (const topic of ["Consent", "Service agreement"]) {
    for (const mode of modes) {
      await page.click("#btn-home");
      await clickText(page, "Start");
      await clickText(page, topic === "Consent" ? "Consent" : "Service agreement");
      // choose how cards use label as card-title
      await page.locator(".topic-card").filter({ hasText: mode === "With a supporter" ? "With a supporter" : mode }).first().click();
      const main = await page.locator("#main").innerText();
      log(main.length > 20, name + ": " + topic + " Ã— " + mode + " loads");
    }
  }

  await browser.close();
}

(async () => {
  let edgeOk = false;
  let ffOk = false;
  try {
    await runFlow(chromium, "edge", true);
    edgeOk = true;
  } catch (e) {
    log(false, "edge runner error: " + e.message);
  }
  try {
    await runFlow(firefox, "firefox", false);
    ffOk = true;
  } catch (e) {
    log(false, "firefox runner error: " + e.message);
  }

  const failed = results.filter((r) => !r.ok);
  console.log("\nSummary: " + (results.length - failed.length) + "/" + results.length + " passed");
  console.log("Browsers: Edge=" + edgeOk + " Firefox=" + ffOk);
  fs.writeFileSync(
    path.join(root, "docs", "qa-run-results.json"),
    JSON.stringify({ results, edgeOk, ffOk, at: new Date().toISOString() }, null, 2)
  );
  process.exit(failed.length ? 1 : 0);
})();

